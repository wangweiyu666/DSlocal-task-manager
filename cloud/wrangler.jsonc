{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dstationery-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "71001",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "71002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "RESEND_FROM": "DStationery Local <onboarding@resend.dev>"
  },
  "secrets": {
    "required": [
      "AUTH_PEPPER",
      "ADMIN_EMAIL",
      "RESEND_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dstationery-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      "binding": "DELETION_LEDGER",
      "database_name": "dstationery-deletion-ledger-local",
      "database_id": "11111111-1111-1111-1111-111111111111",
      "migrations_dir": "deletion-ledger-migrations"
    }
  ],
  "env": {
    "production": {
      "name": "dstationery-api-production",
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "71021",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "71022",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ],
      "workers_dev": false,
      "triggers": {
        "crons": [
          "17 * * * *"
        ]
      },
      "routes": [
        {
          "pattern": "api.rochelimit.me",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "RESEND_FROM": "DStationery <no-reply@notify.rochelimit.me>"
      },
      "secrets": {
        "required": [
          "AUTH_PEPPER",
          "ADMIN_EMAIL",
          "RESEND_API_KEY",
          "ALLOWED_ORIGIN",
          "ACCESS_TEAM_DOMAIN",
          "ACCESS_AUD"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dstationery-production",
          "database_id": "e3c77149-a800-4843-9209-5226264109bd",
          "migrations_dir": "migrations"
        },
        {
          "binding": "DELETION_LEDGER",
          "database_name": "dstationery-deletion-ledger-production",
          "database_id": "ecacc9e4-0c7c-484a-9045-d846b0950c7f",
          "migrations_dir": "deletion-ledger-migrations"
        }
      ]
    }
  }
}
