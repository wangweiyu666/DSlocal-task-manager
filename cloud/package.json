{
  "name": "dstationery-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:minimum": "vitest run tests/sync-recovery.test.ts tests/shared-protocol.test.ts",
    "check": "npm run typecheck && npm test",
    "smoke:local": "node scripts/smoke-local.mjs",
    "migrate:local": "wrangler d1 migrations apply dstationery-local --local && wrangler d1 migrations apply dstationery-deletion-ledger-local --local --config wrangler.jsonc",
    "deploy:production": "node scripts/guard-environment.mjs production && wrangler deploy --env production",
    "guard:production": "node scripts/guard-environment.mjs production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260816.1",
    "@types/node": "22.10.2",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  }
}
