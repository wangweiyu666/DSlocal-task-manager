{
  "name": "dstationery-dom-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode offline",
    "dev:offline": "vite --mode offline",
    "dev:connected": "vite --mode connected",
    "prebuild": "npm run typecheck",
    "build": "npm run build:offline",
    "build:offline": "vite build --mode offline",
    "build:connected": "vite build --mode connected",
    "build:all": "npm run verify:protocol && npm run typecheck && npm run build:offline && npm run build:connected && npm run verify:boundaries",
    "verify:boundaries": "node scripts/verify-build-boundaries.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:minimum": "vitest run tests/connected-sync-scheduler.test.ts tests/connected-results.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:connected-smoke": "playwright test --config=playwright.connected.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "generate:protocol": "node scripts/generate-protocol-validator.mjs",
    "verify:protocol": "node scripts/generate-protocol-validator.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "ajv": "^8.17.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "pako": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.6",
    "esbuild": "0.25.12"
  }
}
