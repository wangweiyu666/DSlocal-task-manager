{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dstationery-connected",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist-connected",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "dstationery-api"
    }
  ],
  "env": {
    "production": {
      "name": "dstationery-connected-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "prod.rochelimit.me",
          "custom_domain": true
        }
      ],
      "vars": {
        "ACCESS_REQUIRED": "true",
        "MANAGEMENT_HOST": "prod.rochelimit.me"
      },
      "secrets": {
        "required": [
          "ACCESS_TEAM_DOMAIN",
          "ACCESS_AUD",
          "MANAGEMENT_ADMIN_EMAIL"
        ]
      },
      "services": [
        {
          "binding": "API",
          "service": "dstationery-api-production"
        }
      ]
    }
  }
}
